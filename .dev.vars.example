BASE_URL="http://localhost:3000"
SIGNUP_ENABLED="false"
# Generate a long random value; keep stable across restarts.
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# Generate 32 random bytes encoded as base64. Never change without migrating encrypted credentials.
CREDENTIALS_KEY="REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES"
EMAIL_FROM="TrackRank <login@mail.trackrank.ai>"
# Optional local authentication providers. Use separate development OAuth credentials.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# RESEND_API_KEY=""
